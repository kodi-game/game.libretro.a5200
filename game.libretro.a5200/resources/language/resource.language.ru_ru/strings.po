msgid "BIOS (Restart)"
msgstr "BIOS (Перезапуск)"

msgctxt "#30002"
msgid "Interframe Blending"
msgstr "Смешивание межкадров"

msgctxt "#30003"
msgid "Hi-Res Artifacting Mode"
msgstr "Режим артефактов высокого разрешения"

