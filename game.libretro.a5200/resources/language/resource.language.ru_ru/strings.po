msgid "Controller Hacks"
msgstr "Хаки контроллера"

msgctxt "#30008"
msgid "Pause acts as Reset"
msgstr "Пауза действует как сброс"

msgctxt "#30009"
msgid "Digital Joystick Sensitivity"
msgstr "Чувствительность цифрового джойстика"

msgctxt "#30010"
msgid "Analog Joystick Sensitivity"
msgstr "Чувствительность аналогового джойстика"

msgctxt "#30011"
msgid "Analog Joystick Response"
msgstr "Отклик аналогового джойстика"

msgctxt "#30012"
